# Copy to .env (which is gitignored) and fill in. Only the provider(s) in your
# config's llm.provider_order need to be set.

# --- LLM providers (fallback router tiers) ---
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=                 # Gemini: controller + generator + embeddings (primary)
GROQ_API_KEY=                   # fallback provider tier
# Ollama runs locally; override only if not on the default host.
# OLLAMA_HOST=http://localhost:11434

# --- Storage (pgvector store + durable daily budget) ---
# Neon (or any) Postgres with the `vector` extension. Required when STORE_PROVIDER=pgvector.
DATABASE_URL=postgresql://user:pass@host/db?sslmode=require

# --- Corpus ---
# Where the corpus lives. Defaults to ./corpus (the seed set) until your own
# documentation exists, at which point point this at it.
CORPUS_ROOT=./corpus

# --- Optional: LangSmith tracing ---
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=AgenticRAG
LANGSMITH_TRACING=false

# --- Optional: ntfy mobile push (server/notify.py) ---
# Buzz your phone when someone asks a question. Subscribe to this topic in the ntfy app.
# The topic name IS the only access control (public namespace) — pick an unguessable one.
NTFY_TOPIC=                                     # unset = notifications off
# NTFY_SERVER=https://ntfy.sh                    # override only if self-hosting ntfy
# NTFY_MIN_INTERVAL_SECONDS=60                    # anti-spam cooldown between pushes

# --- Deploy-time (set as Hugging Face Space secrets/vars; not needed for local dev) ---
# STORE_PROVIDER=pgvector                       # deployed store (local dev defaults to chromadb)
# DAILY_TOKEN_BUDGET=1000000                    # durable per-day $0 kill-switch (0 = off)
# FRONTEND_ORIGINS=https://your-app.vercel.app  # CORS allowlist (comma-separated)
# LLM_CACHE_PATH=./chromadb_data/llm_cache.sqlite
