# Copy to .env (which is gitignored) and fill in. Only the provider(s) in your
# config's llm.provider_order need to be set.

# --- LLM providers (fallback router tiers) ---
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
GROQ_API_KEY=
# Ollama runs locally; override only if not on the default host.
# OLLAMA_HOST=http://localhost:11434

# --- Corpus ---
# Where the corpus lives. Defaults to ./corpus (the seed set) until your own
# documentation exists, at which point point this at it.
CORPUS_ROOT=./corpus
